# Alamat dasar API. Gunakan path relatif /api/v1 agar lewat proxy Vite (dev) / reverse proxy (prod).
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=Administrasi Sekolah
VITE_DEFAULT_TIMEZONE=Asia/Jakarta
# true = gunakan mock API (MSW) di browser; false = gunakan backend Golang sungguhan.
VITE_ENABLE_MOCK_API=true
